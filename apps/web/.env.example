# Set these in Vercel → Project → Settings → Environment Variables.
# NEVER use NEXT_PUBLIC_ for secrets or commit an actual .env file.
# Use a pooled Neon connection string with sslmode=require for application requests.
DATABASE_URL=postgresql://USERNAME:PASSWORD@POOLER-HOST/DBNAME?sslmode=require

# Run infra/migrations/0001_auth_workspaces.sql once using the DIRECT Neon connection URL.
# Do not paste production secrets into a chat or commit migrations with credentials.
# EMAIL_PROVIDER_* are required before enabling real email verification, recovery and admin activation.
# No default admin exists, and no workspace owner automatically becomes a platform admin.

# Optional mail delivery (required to enable email verification or password recovery).
# Add these to Vercel encrypted environment settings, NOT to Git.
RESEND_API_KEY=
EMAIL_FROM=
OTP_PEPPER=

# PG01 admin TOTP: random 32-byte base64url secret, Vercel encrypted env only.
MFA_ENCRYPTION_KEY=

# Optional dedicated simulator API process. No live financial URL/key allowed there.
# Required only for developer sandbox scenarios; never falls back to GO_API_URL.
GO_SANDBOX_API_URL=

# Google sign-in. All server-only; button stays hidden until all four exist.
# Google Cloud OAuth client type: Web application.
# Authorized redirect: https://ekmivo-web.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_AUTH_ORIGIN=https://ekmivo-web.vercel.app
# Independent random 32-byte base64url key (43 chars), generated in Vercel.
GOOGLE_STATE_SECRET=

# Store-first SaaS order summary. Keep PREVIEW disabled for customers until
# the versioned legal-consent, coupon and backend invoice-confirmation gates pass.
# A preview is never authorization to collect money.
EKMIVO_SUBSCRIPTION_ORDER_PREVIEW=0
# Legal links and their immutable version hashes now come from Admin Settings
# (Legal & contact) in the control database; no unversioned env fallback.
