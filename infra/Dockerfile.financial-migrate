FROM golang:1.27.0-alpine AS build
WORKDIR /repo/backend
COPY backend/go.mod backend/go.sum ./
COPY backend/cmd ./cmd
COPY backend/internal ./internal
RUN go mod tidy && CGO_ENABLED=0 go build -trimpath -o /out/financial-migrate ./cmd/financial-migrate

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/financial-migrate /financial-migrate
COPY infra/migrations /infra/migrations
USER nonroot:nonroot
ENV PG04_CONTROL_MIGRATION_FILE=/infra/migrations/0009_pg04_control_projection.sql
ENV PG04_FINANCIAL_MIGRATION_FILE=/infra/migrations/0008_pg04_financial_core.sql
# Requires explicit PG04_ALLOW_MIGRATION=true and three independently
# authorized migration URLs; migration is never started by API/worker.
ENTRYPOINT ["/financial-migrate"]
